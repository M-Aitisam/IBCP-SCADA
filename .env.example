# development | production. In production a strong SECRET_KEY is required
# and the interactive API docs are disabled by default.
ENVIRONMENT=development

# Any standard Postgres connection string works — postgresql:// or postgres://
# is auto-converted to the asyncpg driver at startup. Get one from Vercel
# Postgres, Supabase, Neon, or a local Postgres instance.
DATABASE_URL=postgresql://user:password@localhost:5432/ibcp_scada
REDIS_URL=redis://localhost:6379
MQTT_BROKER=localhost
MQTT_PORT=1883
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-secret-key-change-this

# Comma-separated exact origins. Wildcards do NOT work here (Starlette
# matches these literally) - use CORS_ORIGIN_REGEX for preview deploys.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.vercel\.app$

# Set true only behind a long-lived server (uvicorn on a VM/container).
# Must stay false on serverless: pooled asyncpg connections are bound to
# the event loop that opened them.
DB_POOL_ENABLED=false

# Interactive API docs at /docs. Consider false in production.
ENABLE_DOCS=true

# Google Earth Engine
GEE_PROJECT=your-gee-project-id

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MQTT_BROKER=ws://localhost:9001
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token

# Firebase (for alerts)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id

# ============================================
# Google Earth Engine acquisition pipeline
# (packages/backend/app/ingestion)
# ============================================
# Earth Engine cloud project - the `project_id` field of the key file,
# e.g. my-project-123456. NOT the numeric `client_id`.
# If left blank it is derived from GEE_SERVICE_ACCOUNT.
GEE_PROJECT_ID=

# Service-account credentials for unattended runs. NEVER commit a real key.
# GEE_PRIVATE_KEY accepts the raw service-account JSON or the same JSON
# base64-encoded (use base64 in CI secret stores, which mangle newlines).
GEE_SERVICE_ACCOUNT=gee-ingest@your-project.iam.gserviceaccount.com
# GEE_PRIVATE_KEY takes the WHOLE key file, not one field out of it. Easiest
# locally is an absolute path to the downloaded .json:
#   GEE_PRIVATE_KEY=C:/Users/you/keys/ibcp-gee.json
# In CI, base64-encode the file contents instead.
# Common mistakes: pasting `private_key_id` (a 40-char fingerprint) or the
# `private_key` PEM block. Both are rejected with an explanatory message.
GEE_PRIVATE_KEY=
# Alternative to the two variables above, for local development:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json

# Temporal window. GEE_TARGET_END is a REQUESTED cutoff, not a claim that any
# dataset actually has data through that date.
GEE_HISTORICAL_START=2016-01-01
GEE_TARGET_END=2026-08-19
# Days of already-ingested time re-queried each daily run so late-published
# scenes are picked up. Safe because writes are idempotent upserts.
GEE_LOOKBACK_DAYS=7

# Sentinel-2 scene-level cloud cover ceiling, percent.
GEE_CLOUD_THRESHOLD=20

# Region of interest. Default is GEE's FAO GAUL level-2 admin boundaries
# filtered to the two target provinces. NOTE: GAUL level 2 is DISTRICT level
# for Pakistan, not tehsil. Set GEE_ROI_GEOJSON_PATH to a real tehsil boundary
# file (and the property names below) to get tehsil granularity.
GEE_ROI_ASSET_ID=FAO/GAUL/2015/level2
GEE_ROI_PROVINCES=Balochistan,Sindh
GEE_ROI_COUNTRY=Pakistan
GEE_ROI_REGION_TYPE=district
# GEE_ROI_GEOJSON_PATH=
# GEE_ROI_TEHSIL_PROPERTY=
# Cap regions per run (used by the small verification run).
# GEE_ROI_LIMIT=

# Set false to make the daily scheduler a no-op without removing the cron.
GEE_DAILY_ENABLED=true

